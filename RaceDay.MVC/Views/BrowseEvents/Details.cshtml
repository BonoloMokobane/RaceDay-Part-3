@model RaceDay.MVC.Models.EventViewModel

@{
    ViewData["Title"] = "Event Details";
}

<div class="container py-4">
    <a asp-action="Index" class="btn btn-outline-secondary mb-3">
        Back to Events
    </a>

    @if (!string.IsNullOrWhiteSpace(Model.BannerImageUrl))
    {
        <img src="@Model.BannerImageUrl"
             class="img-fluid rounded mb-4"
             style="width:100%; max-height:350px; object-fit:cover;"
             alt="@Model.Name" />
    }

    <h1>@Model.Name</h1>
    <p class="lead">@Model.Description</p>

    <div class="card mt-3">
        <div class="card-body">
            <p><strong>Date:</strong> @Model.EventDate.ToString("dd MMMM yyyy, HH:mm")</p>
            <p><strong>Location:</strong> @Model.Location</p>
            <p><strong>Distance:</strong> @Model.Distance km</p>
            <p><strong>Event Type:</strong> @Model.EventType</p>
        </div>
    </div>

    <p class="mt-3 text-muted">
        Event enrolment will be available through the enrolment section.
    </p>
</div>