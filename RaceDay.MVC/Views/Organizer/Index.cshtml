@{
    ViewData["Title"] = "Organizer Dashboard";
}

<div class="container mt-5">
    <h1>Organizer Dashboard</h1>
    <p>Welcome, @ViewBag.Email</p>
    <p class="text-muted">
        Manage your events and keep race day running smoothly.
    </p>

    <div class="row g-3 mt-3">
        <div class="col-md-4">
            <div class="card shadow p-4 h-100">
                <h4>My Events</h4>
                <p>Create, update and manage your events.</p>
                <span class="text-muted">Event management coming next.</span>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow p-4 h-100">
                <h4>Categories</h4>
                <p>Manage categories for your events.</p>
                <span class="text-muted">Category management coming next.</span>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow p-4 h-100">
                <h4>Results</h4>
                <p>Manage participant results.</p>
                <span class="text-muted">Results management coming next.</span>
            </div>
        </div>
    </div>
</div>
