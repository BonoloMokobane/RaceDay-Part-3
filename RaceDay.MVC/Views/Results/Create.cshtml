@model RaceDay.MVC.Models.ResultViewModel

@{
    ViewData["Title"] = "Capture Result";
}

<div class="container py-4">
    <h2>Capture Participant Result</h2>

    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="text-danger"></div>

        <input asp-for="EnrollmentId" type="hidden" />
        <input asp-for="EventId" type="hidden" />

        <div class="mb-3">
            <label asp-for="FinishTime" class="form-label">
                Finish Time (HH:MM:SS)
            </label>
            <input asp-for="FinishTime" type="time"
                   step="1" class="form-control" />
            <span asp-validation-for="FinishTime"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="FinishingPosition"
                   class="form-label"></label>
            <input asp-for="FinishingPosition"
                   type="number" min="1" class="form-control" />
            <span asp-validation-for="FinishingPosition"
                  class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">
            Save Result
        </button>
    </form>
</div>
