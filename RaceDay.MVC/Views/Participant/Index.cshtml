@{
    ViewData["Title"] = "Participant Dashboard";
}

<div class="container mt-5">
    <h1>Participant Dashboard</h1>
    <p>Welcome, @ViewBag.Email</p>
    <p class="text-muted">
        Find events, manage your enrolments and view your results.
    </p>

    <div class="row g-3 mt-3">
        <div class="col-md-4">
            <div class="card shadow p-4 h-100">
                <h4>Upcoming Events</h4>
                <p>Discover upcoming running, walking and cycling events.</p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow p-4 h-100">
                <h4>My Enrolments</h4>
                <p>View your event enrolments and their status.</p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow p-4 h-100">
                <h4>My Results</h4>
                <p>View your race history and results.</p>
            </div>
        </div>
    </div>
</div>
